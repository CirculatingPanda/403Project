{
  "kind": "rom_controller",
  "name": "rom_ctrl",
  "description": "16KB ROM with 1-cycle read latency",
  "clock_mhz": 200,
  "reset": {
    "active_low": true,
    "sync": true
  },
  "host_if": {
    "bus": "custom",
    "data_bits": 32,
    "addr_bits": 16,
    "endian": "little"
  },
  "mem": {
    "depth": 4096,
    "data_bits": 32
  },
  "init": {
    "type": "hex_file",
    "source": "firmware.hex"
  },
  "timing": {
    "read_latency_cycles": 1
  }
}
