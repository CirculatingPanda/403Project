{
  "kind": "sram_controller",
  "name": "demo_sram",
  "description": "Simple 4KB SRAM controller for end-to-end demo",
  "clock_mhz": 100,
  "reset": {
    "active_low": true,
    "sync": true
  },
  "host_if": {
    "bus": "AXI4-Lite",
    "data_bits": 32,
    "addr_bits": 12,
    "endian": "little"
  },
  "mem": {
    "depth": 1024,
    "data_bits": 32
  },
  "timing": {
    "read_latency_cycles": 1
  },
  "write_enable_mask": false,
  "chip_selects": 1,
  "ecc": {
    "enabled": false,
    "scheme": null
  }
}