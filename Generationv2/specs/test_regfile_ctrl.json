{
  "kind": "regfile_controller",
  "name": "regfile_ctrl",
  "description": "32x32-bit register file with 2 read ports and 1 write port",
  "clock_mhz": 300,
  "reset": {
    "active_low": true,
    "sync": true
  },
  "host_if": {
    "bus": "custom",
    "data_bits": 32,
    "addr_bits": 0,
    "endian": "little"
  },
  "regfile": {
    "entries": 32,
    "data_bits": 32,
    "read_ports": 2,
    "write_ports": 1,
    "bypass_on_same_cycle": true,
    "hazard_policy": "bypass"
  }
}
